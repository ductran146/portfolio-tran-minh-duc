export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  /** Cạnh hiển thị (px). 20 cạnh chữ · 24 trong icon-tile 48 · 28 trong icon-tile-lg 64 · 32 trong tool-mark. */
  size?: number;
  class?: string;
  /** Có label = icon mang nghĩa (role="img"); không có = trang trí, ẩn với screen reader. */
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;
const def = ICONS[name];
const isMark = def.kind === "mark";
---

<svg
  class:list={["icon", className]}
  data-icon={name}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isMark ? "currentColor" : "none"}
  stroke={isMark ? undefined : "currentColor"}
  stroke-width={isMark ? undefined : "1.5"}
  stroke-linecap={isMark ? undefined : "round"}
  stroke-linejoin={isMark ? undefined : "round"}
  role={label ? "img" : undefined}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {label && <title>{label}</title>}
  <Fragment set:html={def.body} />
</svg>

<!-- Global vì nội dung set:html không nhận scope của Astro. Chỉ transform/opacity.
     Kích hoạt: (a) khi khối chứa icon lộ ra qua reveal (.is-visible), lệch theo
     --i của khối để đi sau đúng nhịp thẻ; (b) khi hover khối có .icon-hover-host —
     đổi animation-name để chạy lại. prefers-reduced-motion đã bị global.css ép
     về 0.001ms, iteration 1. -->
<style is:global>
  .icon-anim .p {
    transform-box: fill-box;
    transform-origin: center;
  }

  .icon-anim[data-icon="chart"] .p {
    transform-origin: center bottom;
  }

  /* ---- Vào cùng lượt reveal của khối chứa ----
     Mặc định mọi icon khái niệm: từng bộ phận pop lần lượt. chart/sparkle có
     kiểu riêng bên dưới. Icon mới chỉ cần gắn .p .pN là có chuyển động. */
  .js-reveal .is-visible .icon-anim .p {
    animation: icon-pop 0.55s var(--ease-page) both;
    animation-delay: calc(var(--i, 0) * 110ms + var(--k) * 90ms + 120ms);
  }

  .js-reveal .is-visible .icon-anim[data-icon="chart"] .p {
    animation: icon-grow 0.6s var(--ease-page) both;
    animation-delay: calc(var(--i, 0) * 110ms + var(--k) * 110ms + 120ms);
  }

  .js-reveal .is-visible .icon-anim[data-icon="sparkle"] .p1 {
    animation: icon-spin-in 0.7s var(--ease-page) both;
    animation-delay: calc(var(--i, 0) * 110ms + 120ms);
  }

  /* Ngôi sao nhỏ lấp lánh chậm, vô hạn — nhỏ và chậm đủ để không kéo mắt. */
  .js-reveal .is-visible .icon-anim[data-icon="sparkle"] .p2 {
    animation: icon-twinkle 2.6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * 110ms + 800ms);
  }

  .icon-anim .p1 { --k: 0; }
  .icon-anim .p2 { --k: 1; }
  .icon-anim .p3 { --k: 2; }
  .icon-anim .p4 { --k: 3; }

  /* ---- Hover khối chứa: chạy lại bằng animation khác ---- */
  .icon-hover-host:hover .icon-anim .p {
    animation: icon-shuffle 0.5s var(--ease-page) both;
    animation-delay: calc(var(--k) * 60ms);
  }

  .icon-hover-host:hover .icon-anim[data-icon="sparkle"] .p2 {
    animation: icon-twinkle 2.6s ease-in-out infinite;
  }

  .icon-hover-host:hover .icon-anim[data-icon="chart"] .p {
    animation: icon-regrow 0.55s var(--ease-page) both;
    animation-delay: calc(var(--k) * 70ms);
  }

  .icon-hover-host:hover .icon-anim[data-icon="sparkle"] .p1 {
    animation: icon-tilt 0.6s var(--ease-page) both;
  }

  /* ---- Brand mark nhiều màu khi hover (host có .brand-hover-host) ----
     Ngoại lệ có chủ đích của quy tắc một màu accent: màu hãng CHỈ xuất hiện trên
     mark, CHỈ khi hover (DESIGN.md › Iconography). Khi nghỉ mọi part là
     currentColor (đơn sắc). Hex Figma theo brand guideline chính thức; Photoshop
     navy #001E36 + xanh #31A8FF là diện mạo icon ứng dụng thật. */
  [data-icon="figma"] .fg-outline,
  [data-icon="figma"] .b,
  [data-icon="photoshop"] .ps-bg,
  [data-icon="photoshop"] .ps-fg {
    transition: fill 0.3s var(--ease-smooth);
  }

  /* Figma khi nghỉ = outline Simple Icons (currentColor); 5 khối đặc ẩn. Hover →
     outline tan, 5 khối tô màu hãng nổi lên đúng bên trong đường tâm outline
     (2026-09-18: bản vẽ nét bằng stroke bị to và lệch với khối màu — đã bỏ). */
  [data-icon="figma"] .b { fill: transparent; }
  .brand-hover-host:hover [data-icon="figma"] .fg-outline { fill: transparent; }
  .brand-hover-host:hover [data-icon="figma"] .b1 { fill: #f24e1e; }
  .brand-hover-host:hover [data-icon="figma"] .b2 { fill: #ff7262; }
  .brand-hover-host:hover [data-icon="figma"] .b3 { fill: #a259ff; }
  .brand-hover-host:hover [data-icon="figma"] .b4 { fill: #1abcfe; }
  .brand-hover-host:hover [data-icon="figma"] .b5 { fill: #0acf83; }

  .brand-hover-host:hover [data-icon="photoshop"] .ps-bg { fill: #31a8ff; }
  .brand-hover-host:hover [data-icon="photoshop"] .ps-fg { fill: #001e36; }

  @keyframes icon-pop {
    from { transform: scale(0.2); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  @keyframes icon-grow {
    from { transform: scaleY(0); }
    to { transform: none; }
  }

  @keyframes icon-spin-in {
    from { transform: scale(0.3) rotate(-90deg); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  @keyframes icon-twinkle {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.55) rotate(20deg); opacity: 0.55; }
  }

  @keyframes icon-shuffle {
    0% { transform: scale(1); }
    45% { transform: scale(0.72); }
    100% { transform: scale(1); }
  }

  @keyframes icon-regrow {
    0% { transform: scaleY(1); }
    40% { transform: scaleY(0.35); }
    100% { transform: scaleY(1); }
  }

  @keyframes icon-tilt {
    0% { transform: rotate(0); }
    50% { transform: rotate(18deg) scale(1.08); }
    100% { transform: rotate(0); }
  }
</style>
