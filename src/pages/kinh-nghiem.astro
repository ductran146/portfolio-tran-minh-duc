---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Testimonials from "../components/Testimonials.astro";
import ProcessStack from "../components/ProcessStack.astro";
import { dtOutlinePaths, glintLayers } from "../data/dt-glint";
import { withBase } from "../i18n/ui";

// `era` KHÔNG còn dùng để chọn cảnh minh hoạ (2026-09-18: panel bên phải đổi
// sang minh hoạ "cây" cố định — từ 2026-09-19 là <img> trỏ thẳng tới
// public/images/tree-stroke-8-animated.svg — không còn đổi theo mốc thời gian
// đang đọc). Giữ nguyên field này trong dữ liệu vì nó vẫn mô tả đúng giai đoạn
// nghề nghiệp, phòng khi cần dùng lại sau này; chỉ không còn nơi nào đọc giá
// trị của nó. `from`/`to` chỉ là năm rút từ `range`, dùng cho con số lớn trong
// panel — không phải dữ liệu mới.

// Câu dưới cây (người dùng soạn, 2026-09-19). Tách sẵn thành từng TỪ lúc build
// cho hiệu ứng hiện dần theo từ (`--i` = thứ tự từ trên cả câu → độ trễ), cùng
// cách làm với tiêu đề hero ở index.astro nhưng theo từ chứ không theo ký tự.
// Từ khoá bọc trong *...* (dấu câu đứng ngay sau dấu * đóng vẫn dính vào từ):
// sau khi cả câu hiện đủ ở weight thường, một vệt sáng mờ chạy lần lượt qua
// từng dòng và cụm nào bị vệt sáng đi qua thì đậm lên (yêu cầu người dùng
// 2026-09-19). `--k` = thứ tự cụm; `--kf` = vị trí tâm cụm trong dòng theo TỈ
// LỆ KÝ TỰ (0..1) — CSS không đo được toạ độ chữ, tỉ lệ ký tự trên font tỉ lệ
// là xấp xỉ đủ tốt để mốc đậm khớp lúc vệt sáng đi qua.
const treeCaptionLines = [
  { text: "*Cây* luôn hướng tới ánh sáng và *phát triển*,", me: false },
  { text: "*tôi* luôn tìm cách *học hỏi* và *hoàn thiện*.", me: true },
];
type CaptionWord = { word: string; i: number; k?: number; kf?: number };
let captionWordIndex = 0;
let captionKeyIndex = 0;
const treeCaption = treeCaptionLines.map((line) => {
  const words: CaptionWord[] = [];
  const plainLength = line.text.replace(/\*/g, "").length;
  for (const m of line.text.matchAll(/\*([^*]+)\*(\S*)|(\S+)/g)) {
    if (m[1] !== undefined) {
      const k = captionKeyIndex++;
      const starsBefore = (line.text.slice(0, m.index).match(/\*/g) ?? []).length;
      const start = m.index - starsBefore;
      const kf = +((start + (m[1].length + m[2].length) / 2) / plainLength).toFixed(3);
      const parts = m[1].split(" ");
      parts.forEach((p, pi) => words.push({ word: pi === parts.length - 1 ? p + m[2] : p, i: captionWordIndex++, k, kf }));
    } else {
      words.push({ word: m[3], i: captionWordIndex++ });
    }
  }
  return { me: line.me, words };
});
const treeCaptionWordCount = captionWordIndex;

const experience = [
  {
    range: "T12/2019 - Hiện tại",
    from: 2019,
    to: null,
    current: true,
    role: "Senior UI Designer",
    company: "Difisoft Vietnam JSC",
    era: "fintech",
    lines: [
      "Phối hợp với Product Owner thiết kế UI, tương tác cho sản phẩm fintech",
      "Nghiên cứu người dùng, xây dựng user flow, định hướng UX cho mobile & web",
      "Thiết kế landing page và banner marketing",
    ],
  },
  {
    range: "T4/2014 - T12/2019",
    from: 2014,
    to: 2019,
    current: false,
    role: "Lead of Design",
    company: "CAIA Technology and Communications JSC",
    era: "brand",
    lines: [
      "Dẫn dắt đội thiết kế giao diện website, banner, hình ảnh cho nhiều khách hàng",
      "Xây dựng hệ thống nhận diện thương hiệu: logo, brochure, danh thiếp, brand guideline",
    ],
  },
  {
    range: "T4/2012 - T4/2014",
    from: 2012,
    to: 2014,
    current: false,
    role: "Lead of Design",
    company: "Hurasoft JSC",
    era: "web",
    lines: [
      "Chỉ đạo sản xuất thiết kế giao diện web và tài sản hình ảnh cho khách hàng",
      "Thực hiện ấn phẩm nhận diện thương hiệu",
    ],
  },
  {
    range: "T10/2009 - T4/2012",
    from: 2009,
    to: 2012,
    current: false,
    role: "Web & Graphic Designer",
    company: "Finalstyle Company Limited",
    era: "graphic",
    lines: [
      "Thiết kế giao diện website, banner quảng cáo, tài sản hình ảnh",
      "Xây dựng bộ nhận diện thương hiệu, prototype và mockup tương tác",
    ],
  },
];

// Nội dung 3 mục chuyên môn (người dùng cung cấp 2026-09-20, viết lại để nói
// "có gì" — lĩnh vực/loại sản phẩm — không trùng với "cách làm" ở section quy
// trình phía trên; mục AI cũ đã hoà vào hàng "Công cụ hỗ trợ").
const expertise = [
  {
    icon: "chart",
    title: "Fintech & sản phẩm nhiều dữ liệu",
    body: "Thiết kế sản phẩm chứng khoán, giao dịch tài chính và dashboard có mật độ thông tin cao; tổ chức dữ liệu để người dùng theo dõi và thực hiện tác vụ chính xác hơn.",
  },
  {
    icon: "layers",
    title: "Hệ thống vận hành doanh nghiệp",
    body: "Thiết kế sản phẩm phục vụ nhiều vai trò, quy trình và trạng thái; chuyển nghiệp vụ vận hành thành trải nghiệm rõ ràng và dễ sử dụng.",
  },
  {
    icon: "tokens",
    title: "Design System đa nền tảng",
    body: "Xây dựng token, component, variant và responsive pattern dùng chung, giúp web và mobile duy trì tính nhất quán khi sản phẩm mở rộng.",
  },
] as const;

// Nền tảng — tách riêng khỏi 3 mục chuyên môn (theo yêu cầu 2026-09-18). Hai mục
// này lấy từ danh sách kỹ năng trong CV (Mobile App Design, Web Responsive
// Design); mô tả ghép từ các dòng kinh nghiệm đã có — không thêm năng lực mới.
// Mục Web Responsive viết lại 2026-09-20 để không lặp nguyên văn "token,
// component dùng chung cho web và mobile" đã có ở "Design System đa nền tảng".
const platforms = [
  {
    icon: "mobile",
    title: "Mobile App Design",
    body: "Thiết kế giao diện và tương tác ứng dụng di động cho sản phẩm fintech, đi từ user flow và định hướng UX đến màn hình hoàn thiện.",
  },
  {
    icon: "responsive",
    title: "Web Responsive Design",
    body: "Thiết kế web hiển thị nhất quán trên mọi cỡ màn hình: bố cục, lưới và trạng thái tương tác được tính cho desktop lẫn tablet, nối liền với bản mobile.",
  },
] as const;

// ---- Section "Cách tôi làm việc" (2026-09-20, thay dải công cụ) ----
// 4 bước nối tiếp, nội dung nguyên văn người dùng cung cấp. Số thứ tự hiện to
// mờ (aria-hidden), "Bước 0N:" đọc được qua .sr-only trong <h3>. Icon nét từ
// Icon.astro (search/flow thêm 2026-09-20 cho đúng nghĩa bước 01/02).
const processSteps = [
  {
    n: "01",
    icon: "search",
    title: "Làm rõ bài toán",
    body: "Phân tích người dùng, quy trình và ràng buộc nghiệp vụ để xác định đúng vấn đề cần giải quyết.",
  },
  {
    n: "02",
    icon: "flow",
    title: "Tổ chức trải nghiệm",
    body: "Chuyển nghiệp vụ thành cấu trúc thông tin, user flow và trạng thái rõ ràng, dễ thao tác.",
  },
  {
    n: "03",
    icon: "tokens",
    title: "Xây dựng hệ thống giao diện",
    body: "Thiết kế token, component và responsive pattern dùng chung cho web và mobile.",
  },
  {
    n: "04",
    icon: "check-circle",
    title: "Kiểm chứng và triển khai",
    body: "Tạo prototype để kiểm tra giải pháp và phối hợp cùng đội ngũ trong quá trình phát triển.",
  },
] as const;

// Công cụ hỗ trợ: SECTION RIÊNG ngay sau mảng tối (tách 2026-09-20 để hai nhóm
// nội dung có phân cấp rõ; trước là một hàng nhỏ cuối box tối). 4 card cùng
// chiều cao, icon lớn. Mặc định trung tính (icon xám trên tile bg-soft); hover
// mới lộ màu: card là .brand-hover-host nên mark Figma/Photoshop tự tô màu hãng
// theo Icon.astro, icon nét (code/sparkle) sang accent. ChatGPT/Claude không
// còn là hai năng lực riêng — gộp thành "AI-assisted workflow".
const supportTools = [
  { icon: "figma", name: "Figma", body: "Thiết kế UI, xây dựng component, design system và prototype tương tác." },
  { icon: "code", name: "HTML/CSS", body: "Kiểm tra responsive, trạng thái giao diện và tạo prototype gần với sản phẩm thật." },
  { icon: "photoshop", name: "Photoshop", body: "Xử lý hình ảnh, tài sản đồ họa và nội dung trực quan cho sản phẩm." },
  { icon: "sparkle", name: "AI-assisted workflow", body: "Hỗ trợ phân tích yêu cầu, khám phá phương án và kiểm tra tính nhất quán trong quá trình thiết kế." },
] as const;

// Logo DT nét + vệt sáng: dữ liệu và công thức dùng chung với trang chủ ở
// src/data/dt-glint.ts (tách 2026-09-20 khi trang chủ cũng dùng hiệu ứng này).

// Đánh giá: dùng component Testimonials (dữ liệu chung src/data/testimonials.ts).
---

<BaseLayout title="Kinh nghiệm - Trần Minh Đức" description="Kinh nghiệm làm việc, chuyên môn và đánh giá khách hàng của Trần Minh Đức.">
	<main>
		<!-- Hero hai cột (2026-09-19): chữ bên trái, bên phải là minh hoạ quy trình
		     4 bước (ProcessStack: 4 ảnh render 3D xếp tầng, animation lặp). Minh
		     hoạ thuần trang trí (aria-hidden trong component) — lede đã kể đủ
		     "từ phân tích nghiệp vụ đến UI, design system và prototype". -->
		<header class="page-head">
			<div class="page-head-copy">
				<p class="section-label" data-reveal>Kinh nghiệm & Chuyên môn</p>
				<!-- Tiêu đề do người dùng đặt (2026-09-19); ý "chuyên sâu fintech" chuyển
				     xuống lede theo yêu cầu, lede viết lại cho liền mạch. -->
				<h1 data-reveal>15+ năm kinh nghiệm thiết kế sản phẩm số</h1>
				<p class="lede" data-reveal>
					Với kinh nghiệm chuyên sâu trong fintech, tôi giúp đội ngũ đi từ phân tích nghiệp vụ đến UI,
					design system và prototype để tạo ra sản phẩm dễ sử dụng, nhất quán và sẵn sàng phát triển.
				</p>
			</div>
			<div class="page-head-visual">
				<ProcessStack />
			</div>
		</header>

		<section class="block">
			<h2 data-reveal>Kinh nghiệm làm việc</h2>
			<div class="timeline-layout">
				<!-- Timeline "đọc theo cuộn": một đường accent tô dần theo vị trí cuộn
				     (scaleY), chấm và nội dung của từng mốc chỉ hiện khi đường tô đi
				     qua. Không dùng data-reveal chung: ở đây cần mốc nào cuộn tới mới
				     hiện mốc đó, kể cả khi cả bốn mốc đã nằm trong viewport. -->
				<ol class="timeline" id="timeline">
					<span class="timeline-fill" aria-hidden="true"></span>
					{
						experience.map((job, i) => (
							<li class="timeline-item" data-era={i}>
								<div class="timeline-marker" aria-hidden="true">
									<span class={`dot ${job.current ? "dot-current" : ""}`} />
								</div>
								<div class="timeline-content">
									<span class="timeline-range tabular">{job.range}</span>
									<h3>
										{job.role} - {job.company}
										{job.current && <span class="pill">Hiện tại</span>}
									</h3>
									<ul>
										{job.lines.map((line, k) => (
											<li style={`--k: ${k}`}>{line}</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
				</ol>

				<!-- Panel dính bên phải: minh hoạ "cây" + câu ngắn gắn ẩn ý cây lớn =
				     luôn học hỏi/phát triển (2026-09-19). Cây là <img> trỏ THẲNG tới
				     file public/images/tree-stroke-8-animated.svg (bản sao y nguyên của
				     images/tree-stroke-8-animated.svg) — animation, keyframes, chu kỳ
				     15s đều nằm trong file, chạy được trong <img>; không component,
				     không JS, không sửa file (yêu cầu người dùng). <source> reduced-
				     motion trỏ bản tĩnh tree-stroke-8.svg (cùng 8 path, không
				     animation): media query TRONG SVG-as-image chỉ nhận cài đặt cấp
				     OS/trình duyệt, còn <source media> do trang đánh giá nên chắc ở
				     mọi nguồn. width/height = viewBox để giữ chỗ, không nhảy layout.
				     alt rỗng vì trang trí — câu chữ bên dưới mới mang nghĩa, nên
				     <aside> KHÔNG aria-hidden. -->
				<aside class="era-panel">
					<picture>
						<source media="(prefers-reduced-motion: reduce)" srcset={withBase("/images/tree-stroke-8.svg")} type="image/svg+xml" />
						<img
							class="tree-figure"
							src={withBase("/images/tree-stroke-8-animated.svg")}
							width="585"
							height="586"
							alt=""
							decoding="async"
						/>
					</picture>
					<p class="tree-caption" data-reveal style={`--tc-n: ${treeCaptionWordCount}`}>
						<span class="tc-quote" aria-hidden="true">“</span>
						{
							treeCaption.map((line, li) => (
								<>
									<span class:list={["tc-line", line.me ? "tc-me" : "tc-tree"]} style={`--l: ${li}`}>
										{line.words.map((w, wi) => (
											<>
												<span
													class:list={["tc-w", { "tc-k": w.k !== undefined }]}
													style={`--i: ${w.i}${w.k !== undefined ? `; --k: ${w.k}; --kf: ${w.kf}` : ""}`}
													data-w={w.k !== undefined ? w.word : undefined}
												>
													{w.word}
												</span>
												{wi < line.words.length - 1 ? " " : null}
											</>
										))}
									</span>
									{/* Khoảng trắng giữa hai dòng để textContent/AT không dính "triển,tôi". */}
									{li < treeCaption.length - 1 ? " " : null}
								</>
							))
						}
					</p>
				</aside>
			</div>
		</section>

		<!-- "Cách tôi làm việc" (2026-09-20, THAY dải công cụ): mảng tối tràn hai
		     mép. Có sticky + rèm che (đưa lại 2026-09-21) — xem ghi chú CSS
		     `.process-band`. Logo DT nét + vệt sáng giữ lại làm nền trang trí góc
		     dưới-phải, mờ hơn. Nội dung: intro → 4 bước nối bằng một đường vẽ dần
		     → hàng công cụ phụ. Không JS vẫn hiện đủ: mọi trạng thái ẩn chỉ áp
		     khi html.js-reveal, mở khoá theo .is-visible của <ol> (cơ chế
		     data-reveal chung). Thứ tự DOM = thứ tự đọc 01→04 ở mọi breakpoint. -->
		<!-- .process-scope: khung bao CẢ .process-band LẪN .tools-section
		     (2026-09-21, đồng bộ với trang chủ — xem ghi chú CSS `.process-scope`
		     ở index.astro để hiểu đầy đủ lý do: containing block của sticky phải
		     bao gồm khối theo sau thì mới nhả ghim đúng lúc, không sớm/muộn). -->
		<div class="process-scope">
		<section class="process-band" aria-labelledby="process-title">
			<!-- Logo DT dạng nét, khổ lớn, cạnh sáng + vệt sáng chạy theo nét (T8).
			     Path lấy từ public/logo-dt-green.svg, bỏ fill; pathLength="1000" chuẩn
			     hoá để vệt sáng cùng nhịp trên mọi path. Trang trí → aria-hidden. -->
			<svg class="band-logo" viewBox="0 0 377 434" aria-hidden="true" focusable="false">
				<defs>
					<linearGradient id="dt-edge" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0" stop-color="#ffffff" stop-opacity="0.03" />
						<stop offset="0.45" stop-color="#ffffff" stop-opacity="0.32" />
						<stop offset="0.55" stop-color="#5fc2a2" stop-opacity="0.9" />
						<stop offset="1" stop-color="#ffffff" stop-opacity="0.03" />
					</linearGradient>
					<g id="dt-outline">
						{dtOutlinePaths.map((d) => <path pathLength="1000" d={d} />)}
					</g>
				</defs>
				<use href="#dt-outline" class="base" />
				<!-- Vệt sáng hình con thoi: xem glintLayers ở frontmatter. -->
				{
					glintLayers.map((l) => (
						<use
							href="#dt-outline"
							class="g"
							style={`--s0: ${l.s0}px; --w: ${l.w}; --o: ${l.o}; --blur: ${l.blur}px; --c: ${l.accent ? "var(--accent)" : "var(--on-ink)"}; stroke-dasharray: ${l.len} ${1000 - l.len}`}
						/>
					))
				}
			</svg>
			<div class="process-inner">
				<div class="process-intro">
					<p class="section-label" data-reveal>Cách tôi làm việc</p>
					<!-- Ngắt dòng cố định + vế sau màu accent (yêu cầu 2026-09-21). -->
					<h2 id="process-title" data-reveal>
						<span class="process-title-line">Cách tôi đưa thiết kế</span>
						<span class="process-title-line process-title-accent">đến gần sản phẩm</span>
					</h2>
					<p class="process-lede" data-reveal>
						Tôi kết nối nghiệp vụ, trải nghiệm người dùng và khả năng triển khai để giải pháp không chỉ
						đẹp trên bản thiết kế mà còn vận hành rõ ràng trong sản phẩm thực tế.
					</p>
				</div>

				<!-- Một <ol> mang data-reveal: .is-visible mở khoá toàn bộ chuỗi (node →
				     đoạn nối → node kế → nội dung) bằng transition/animation-delay theo
				     --i; không cần listener riêng. Node + đoạn nối chỉ là thị giác. -->
				<ol class="process-steps" data-reveal>
					{
						processSteps.map((s, i) => (
							<li class="pstep" style={`--i: ${i}`}>
								<span class="pstep-node" aria-hidden="true" />
								<span class="pstep-seg" aria-hidden="true">
									<span class="pstep-seg-line" />
									<span class="pstep-seg-head" />
								</span>
								<div class="pstep-body">
									<span class="pstep-num tabular" aria-hidden="true">{s.n}</span>
									<span class="pstep-icon" aria-hidden="true">
										<Icon name={s.icon} size={22} />
									</span>
									<h3>
										<span class="sr-only">Bước {s.n}: </span>
										{s.title}
									</h3>
									<p>{s.body}</p>
								</div>
							</li>
						))
					}
				</ol>

			</div>
		</section>

		<!-- Công cụ hỗ trợ (2026-09-20): section riêng, nền --bg-soft tràn hai mép =
		     tông trung gian giữa mảng tối của quy trình và nền sáng của Chuyên môn.
		     4 card cùng cao, icon lớn; hiện lần lượt trái→phải qua data-reveal. -->
		<!-- Rút gọn 2026-09-20 (yêu cầu): chỉ còn 4 ô công cụ, bỏ nhãn/tiêu đề/mô tả
		     và dòng kết — aria-label thay cho tiêu đề. -->
		<section class="tools-section" aria-label="Công cụ hỗ trợ">
			<div class="tools-inner">
				<ul class="tools-grid">
					{
						supportTools.map((t, i) => (
							<li class="tool-card brand-hover-host stagger" data-reveal style={`--i: ${i}`}>
								<span class="icon-tile icon-tile-lg tool-icon" aria-hidden="true">
									<Icon name={t.icon} size={28} class="icon-anim" />
								</span>
								<h3>{t.name}</h3>
								<p>{t.body}</p>
