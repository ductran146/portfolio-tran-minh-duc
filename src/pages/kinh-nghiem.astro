		</section>
		</div>

		<section class="block block-after-band">
			<h2 data-reveal>Chuyên môn</h2>
			<!-- Ba thẻ riêng, lưới 3 cột. Thẻ trắng + shadow trên nền trắng. -->
			<ul class="expertise-grid">
				{
					expertise.map((e, i) => (
						<li class="expertise-card icon-hover-host stagger" data-reveal style={`--i: ${i}`}>
							<span class="icon-tile icon-tile-lg" aria-hidden="true">
								<Icon name={e.icon} size={28} class="icon-anim" />
							</span>
							<h3>{e.title}</h3>
							<p>{e.body}</p>
						</li>
					))
				}
			</ul>
		</section>

		<!-- Nền tảng đứng sau Chuyên môn (nền --bg-soft) → khác nền → không kẻ
		     (quy tắc 2026-09-20: chỉ kẻ giữa hai khối CÙNG nền). -->
		<!-- .cover-band: nền --bg tràn mép + z-index để che được dải sticky phía trên
		     (xem ghi chú CSS "Rèm che"). -->
		<section class="block block-flush cover-band">
			<h2 data-reveal>Nền tảng</h2>
			<!-- Hai hộp ngang, nền soft — cố ý khác dáng với 3 thẻ chuyên môn ở trên
			     để hai nhóm không đọc nhầm thành một. -->
			<ul class="platform-grid">
				{
					platforms.map((p, i) => (
						<li class="platform-card icon-hover-host stagger" data-reveal style={`--i: ${i}`}>
							<span class="icon-tile icon-tile-lg" aria-hidden="true">
								<Icon name={p.icon} size={28} class="icon-anim" />
							</span>
							<div>
								<h3>{p.title}</h3>
								<p>{p.body}</p>
							</div>
						</li>
					))
				}
			</ul>
		</section>

		<section class="block cover-band" id="danh-gia">
			<Testimonials />
		</section>
	</main>

	<script>
		// Timeline đọc theo cuộn. Một "đường ngang hiện tại" nằm ở 60% chiều cao
		// viewport (đủ thấp để mốc đầu — nằm ~500px dưới mép trên khi mới tải —
		// hiện ngay, không để trống dưới tiêu đề); đường accent tô từ đầu timeline
		// tới đường đó (scaleY), mốc nào có đầu mốc nằm trên đường đó thì đã "đọc
		// tới": chấm sáng, nội dung hiện, panel bên phải đổi sang năm + cảnh của
		// mốc đó. Chỉ transform/opacity.
		function initTimeline() {
			(window as any).__timelineUpdate = undefined;
			const tl = document.getElementById("timeline");
			if (!tl) return;
			const fill = tl.querySelector<HTMLElement>(".timeline-fill");
			const items = Array.from(tl.querySelectorAll<HTMLElement>(".timeline-item"));
			const panel = document.querySelector<HTMLElement>(".era-panel");
			const eraEls = panel ? Array.from(panel.querySelectorAll<HTMLElement>("[data-era]")) : [];
			const indexEl = document.getElementById("era-index");
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			let active = -1;

			function setActive(i: number) {
				if (i === active) return;
				active = i;
				for (const el of eraEls) el.classList.toggle("is-active", Number(el.dataset.era) === i);
				if (indexEl) indexEl.textContent = String(i + 1).padStart(2, "0");
			}

			function update() {
				const rect = tl!.getBoundingClientRect();
				const anchor = window.innerHeight * 0.6;
				const p = Math.min(1, Math.max(0, (anchor - rect.top) / rect.height));
				if (fill) fill.style.transform = `scaleY(${reduce ? 1 : p})`;
				let reached = 0;
				items.forEach((item, i) => {
					const hit = reduce || item.getBoundingClientRect().top <= anchor;
					item.classList.toggle("is-reached", hit);
					if (hit) reached = i;
				});
				setActive(reached);
			}

			(window as any).__timelineUpdate = update;
			update();
		}

		if (!(window as any).__timelineBound) {
			(window as any).__timelineBound = true;
			const run = () => (window as any).__timelineUpdate?.();
			window.addEventListener("scroll", run, { passive: true });
			window.addEventListener("resize", run);
		}
		// after-swap: DOM mới đã vào, ảnh trạng thái mới chưa chụp → tính ngay để mốc
		// đang trong viewport hiện đủ trong crossfade. page-load: chạy lại cho chắc
		// (font/ảnh có thể đổi chiều cao). Hàm idempotent nên gọi hai lần vô hại.
		document.addEventListener("astro:after-swap", initTimeline);
		document.addEventListener("astro:page-load", initTimeline);
		initTimeline();

		// Rèm che (2026-09-21): đo chiều cao dải "Cách tôi làm việc" → --band-h để
		// CSS quyết định ghim theo mép trên hay mép dưới (xem .process-band). RO
		// theo dõi đổi font/độ rộng; guard data-band-bound để không gắn hai lần khi
		// after-swap và page-load cùng gọi.
		function initBandPin() {
			const band = document.querySelector<HTMLElement>(".process-band");
			if (!band || band.dataset.bandBound) return;
			band.dataset.bandBound = "1";
			const publish = () => band.style.setProperty("--band-h", `${Math.ceil(band.offsetHeight)}px`);
			publish();
			if ("ResizeObserver" in window) new ResizeObserver(publish).observe(band);
			else window.addEventListener("resize", publish);
		}
		document.addEventListener("astro:after-swap", initBandPin);
		document.addEventListener("astro:page-load", initBandPin);
		initBandPin();
	</script>

	<style>
		main {
			max-width: 1160px;
			margin-inline: auto;
			padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 5vw, 3rem) clamp(2rem, 6vw, 4.5rem);
		}

		/* Hero hai cột (2026-09-19): cùng nhịp lưới với hero trang chủ (chữ rộng
		   hơn ảnh, canh giữa theo chiều dọc). ≤900px xếp một cột, minh hoạ nằm
		   DƯỚI chữ (khác trang chủ) để tiêu đề trang vẫn đọc trước. */
		.page-head {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
			gap: clamp(2rem, 5vw, 3.5rem);
			align-items: center;
			padding-block: clamp(1.5rem, 4vw, 2.5rem);
		}

		.page-head-copy {
			max-width: 60ch;
		}

		/* Căn giữa chữ theo SÂN KHẤU ảnh chứ không theo cả cột phải (2026-09-19,
		   theo yêu cầu): cột phải = sân khấu + chú giải 4 bước bên dưới, nên
		   align-items:center đẩy tâm chữ thấp hơn tâm ảnh đúng nửa chiều cao chú
		   giải. Bù bằng margin-bottom trên khối chữ đúng bằng chiều cao chú giải
		   (ProcessStack đo thật và đặt --ps-legend-h trên <html>, kể cả khi chú
		   giải đổi 2 cột ↔ 1 cột; 4.75rem là dự phòng khi chưa có JS) → tâm chữ
		   trùng tâm sân khấu. Chỉ áp dụng khi hai cột (≤900px xếp dọc). */
		@media (min-width: 901px) {
			.page-head-copy {
				margin-bottom: var(--ps-legend-h, 4.75rem);
			}
		}

		@media (max-width: 900px) {
			.page-head {
				grid-template-columns: 1fr;
			}
			.page-head-visual {
				max-width: 480px;
			}
		}

		.section-label {
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--ink-faint);
			text-transform: uppercase;
			letter-spacing: 0.08em;
			margin: 0 0 0.75rem;
		}

		h1 {
			font-size: clamp(1.9rem, 4vw, 2.6rem);
			line-height: 1.15;
		}

		.lede {
			max-width: var(--measure);
			font-size: 1.2rem;
			color: var(--ink-secondary);
			margin: 1.25rem 0 0;
		}

		/* Nhịp giữa các khối (siết lại 2026-09-20 từ 3–4.5rem: các khối giờ xen kẽ
		   nền nên ranh giới đã rõ, đệm lớn làm nội dung xa nhau). Quy tắc đường kẻ
		   (người dùng chốt 2026-09-20): CHỈ kẻ giữa hai khối cùng nền (đầu trang →
		   Kinh nghiệm làm việc; Nền tảng → Đánh giá); hai khối khác nền thì đổi nền
		   đã là ranh giới → .block-flush bỏ kẻ. */
		.block {
			padding-block: clamp(2.5rem, 6vw, 3.5rem);
			border-top: 1px solid var(--border);
		}

		.block-flush {
			border-top: 0;
		}

		/* Khối ngay sau mảng tối không cần đường kẻ: mép mảng đã là ranh giới. */
		.block-after-band {
			border-top: 0;
			/* Nền --bg-soft tràn hai mép bằng pseudo-element (nội dung vẫn nằm trong
			   cột 1160px của main); isolation để z-index:-1 không chui xuống dưới
			   nền body. */
			position: relative;
			isolation: isolate;
		}

		/* Rèm che (2026-09-21, yêu cầu): dải "Cách tôi làm việc" ghim (sticky) ngay
		   dưới header, các khối phía sau trượt lên che dần nó. Muốn che được, mọi
		   khối sau dải phải (1) là positioned với z-index cao hơn dải và (2) có nền
		   TRÀN HAI MÉP — vì dải rộng 100vw còn .block chỉ rộng cột 1160px; không có
		   nền tràn mép thì dải lộ ra hai bên. .tools-section và .block-after-band đã
		   có nền tràn mép sẵn; .cover-band cấp nền --bg tràn mép cho hai khối còn lại
		   (Nền tảng, Đánh giá) theo đúng cách của .block-after-band. Dải được nhả ra
		   khi main kết thúc — lúc đó nó đã bị che kín (tổng chiều cao các khối sau
		   lớn hơn chiều cao dải). */
		.tools-section,
		.block-after-band,
		.cover-band {
			position: relative;
			z-index: 1;
		}

		.cover-band {
			isolation: isolate;
		}

		.cover-band::before {
			content: "";
			position: absolute;
			/* Mép trên kéo lên 3px (2026-09-21, sửa lần 4 — thay cho bản "vẽ đường kẻ
			   ngay trong ::before" trước đó): bản trước khiến đường kẻ phân cách Nền
			   tảng → Đánh giá kéo dài hết chiều ngang MÀN HÌNH (::before rộng 100vw)
			   thay vì chỉ trong khung nội dung 1160px như mọi đường kẻ khác của site
			   — người dùng phát hiện, yêu cầu trả lại đúng khung ban đầu. Biên -3px
			   đủ hấp thụ lệch dưới-pixel ở màn Retina DPR lẻ (nguyên nhân hở 1px lần
			   trước) mà không cần đường kẻ nằm trong lớp phủ full-width nữa. */
			inset: -3px auto 0 calc(50% - 50vw);
			width: 100vw;
			z-index: -1;
			background: var(--bg);
		}

		/* Đường kẻ Nền tảng → Đánh giá (hai khối cùng nền, quy tắc 2026-09-20) quay
		   lại đúng box #danh-gia (khung nội dung 1160px, KHÔNG còn kéo dài hết màn
		   hình — 2026-09-21, sửa lần 4). .block đã có border-top: 1px mặc định;
		   Nền tảng là .block-flush nên tự bỏ (border-top: 0), Đánh giá dùng
		   .block trần nên giữ nguyên — không cần khai báo gì thêm ở đây. */

		.block-after-band::before {
			content: "";
			position: absolute;
			inset: -1px auto 0 calc(50% - 50vw);
			width: 100vw;
			z-index: -1;
			background: var(--bg-soft);
		}

		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.block > h2 {
			font-size: 1.5rem;
			margin-bottom: 2rem;
		}

		.timeline-layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
			gap: clamp(2rem, 5vw, 4.5rem);
			align-items: start;
		}

		.timeline {
			list-style: none;
			margin: 0;
			padding: 0;
			position: relative;
		}

		.timeline::before {
			content: "";
			position: absolute;
			left: 5px;
			top: 6px;
			bottom: 6px;
			width: 1px;
			background: var(--border);
		}

		/* Đường accent tô dần theo cuộn, đè lên đường ray xám. */
		.timeline-fill {
			position: absolute;
			left: 5px;
			top: 6px;
			bottom: 6px;
			width: 1px;
			background: var(--accent);
			transform: scaleY(0);
			transform-origin: top;
		}

		.timeline-item {
			display: grid;
			grid-template-columns: 12px 1fr;
			gap: 1.5rem;
			padding-bottom: 2.25rem;
		}

		.timeline-item:last-child {
			padding-bottom: 0;
		}

		.timeline-marker {
			position: relative;
		}

		.dot {
			display: block;
			width: 11px;
			height: 11px;
			border-radius: 50%;
			background: var(--border);
			margin-top: 6px;
			transition: background 0.4s var(--ease-smooth), box-shadow 0.4s var(--ease-smooth);
		}

		/* Chấm sáng khi đường tô đi qua (JS gắn .is-reached). Không JS: chấm của
		   mốc hiện tại vẫn sáng như cũ để trang không mất tín hiệu. */
		.timeline-item.is-reached .dot,
		:global(html:not(.js-reveal)) .dot-current {
			background: var(--accent);
			box-shadow: 0 0 0 4px var(--accent-tint);
		}

		/* Nội dung mốc: ẩn cho tới khi cuộn tới, và vào theo TỪNG LỚP (2026-09-21):
		   khoảng thời gian (0ms, 0.5s) → tiêu đề (90ms, 0.6s) → từng dòng gạch đầu
		   (220ms + k×110ms, 0.7s) — không hiện cả cụm một lần. Chỉ dưới .js-reveal
		   để không JS vẫn đọc được đầy đủ. Khối .timeline-content tự nó không fade. */
		:global(.js-reveal) .timeline-content > *,
		:global(.js-reveal) .timeline-content li {
			opacity: 0;
			transform: translateY(10px);
			transition:
				opacity var(--ld, 0.6s) var(--ease-smooth) var(--lt, 0ms),
				transform var(--ld, 0.6s) var(--ease-smooth) var(--lt, 0ms);
		}

		:global(.js-reveal) .timeline-content > ul {
			/* <ul> chỉ là hộp chứa; từng <li> mới là lớp. */
			opacity: 1;
			transform: none;
			transition: none;
		}

		:global(.js-reveal) .timeline-range {
			--lt: 0ms;
			--ld: 0.5s;
		}

		:global(.js-reveal) .timeline-content h3 {
			--lt: 90ms;
			--ld: 0.6s;
		}

		:global(.js-reveal) .timeline-content li {
			--lt: calc(220ms + var(--k, 0) * 110ms);
			--ld: 0.7s;
		}

		:global(.js-reveal) .timeline-item.is-reached .timeline-content > *,
		:global(.js-reveal) .timeline-item.is-reached .timeline-content li {
			opacity: 1;
			transform: none;
		}

		.timeline-range {
			font-size: 0.85rem;
			color: var(--ink-faint);
			font-weight: 600;
		}

		.timeline-content h3 {
			font-family: var(--sans);
			font-size: 1.05rem;
			font-weight: 700;
			margin: 0.3rem 0 0.7rem;
			display: flex;
			align-items: center;
			gap: 0.6rem;
			flex-wrap: wrap;
		}

		.pill {
			font-size: 0.72rem;
			font-weight: 600;
			background: var(--accent-tint);
			color: var(--accent-strong);
			padding: 0.2rem 0.6rem;
			border-radius: 999px;
		}

		.timeline-content ul {
			margin: 0;
			padding-left: 1.1rem;
			color: var(--ink-secondary);
		}

		.timeline-content li {
			margin-bottom: 0.3rem;
		}

		/* ---- Panel năm + cảnh minh hoạ (dính bên phải timeline) ---- */
		/* Không còn thẻ nền/shadow bọc ngoài (2026-09-18) — cây nằm trực tiếp
		   trên nền trang, .era-panel chỉ lo việc sticky. */
		.era-panel {
			position: sticky;
			top: 6rem;
		}

		/* Cây = <img> trỏ thẳng file public/images/tree-stroke-8-animated.svg
		   (2026-09-19). Hệ quả của việc dùng <img> thay vì SVG inline: (1) màu nét
		   cố định #0e7e5e trong file, KHÔNG nhận var(--accent) → dark mode sáng
		   nét lên bằng filter trên chính <img> (không đụng file); (2) không thể
		   dừng animation khi cuộn khỏi viewport như bản component cũ — trình
		   duyệt tự tiết chế animation ngoài màn hình, chấp nhận. */
		.tree-figure {
			display: block;
			width: 100%;
			height: auto;
		}

		:global(html[data-theme="dark"]) .tree-figure {
			/* #0e7e5e × 1.6 ≈ rgb(22,202,150) — sát --accent dark #3fc296. */
			filter: brightness(1.6);
		}

		/* Câu dưới cây (2026-09-19): dấu mở ngoặc kép mờ + hai vế xếp hai dòng,
		   cả câu weight thường, màu phụ; chỉ các từ khoá (.tc-k) đậm + màu ink —
		   và chúng chỉ đậm lên khi vệt sáng chạy qua, sau khi cả câu đã hiện đủ
		   (xem hiệu ứng bên dưới). Cỡ chữ nhỏ hơn nội dung chính để không cạnh
		   tranh với cột timeline. */
		.tree-caption {
			margin: 1.25rem auto 0;
			max-width: 32ch;
			text-align: center;
			line-height: 1.55;
			/* Nhịp hiệu ứng (xem khối "Hiệu ứng" bên dưới); --tc-n = số từ, đặt
			   inline từ frontmatter. */
			--tc-start: 400ms;
			--tc-step: 180ms;
			--tc-in: 1.2s;
			--tc-end: calc(var(--tc-start) + (var(--tc-n) - 1) * var(--tc-step) + var(--tc-in));
			--tc-sweep-dur: 2.4s;
			--tc-bold-in: 0.8s;
			/* Màu vệt sáng + phép blend theo theme (xem .tc-line::after): theme sáng
			   dùng lighten với accent pha sáng (kênh-max với chữ xám đậm ra mint
			   thấy rõ); theme tối dùng darken với accent tối sẵn đã sáng. */
			--tc-shine: color-mix(in srgb, var(--accent) 55%, white);
			--tc-blend: lighten;
		}

		:global(html[data-theme="dark"]) .tree-caption {
			--tc-shine: var(--accent);
			--tc-blend: darken;
		}

		/* Dấu mở ngoặc kép mờ — cùng họ .tm-mark ở Testimonials (font display,
		   rất nhạt) nhưng nhỏ và đứng ngay trên câu: báo "đây là câu nói". Thay
		   cho gạch accent trước đó (gạch vốn chỉ là thế thân của dấu ngoặc). */
		.tc-quote {
			display: block;
			height: 1.15rem;
			font-family: var(--display);
			font-size: 2.75rem;
			line-height: 0.7;
			color: var(--ink-faint);
			opacity: 0.55;
			user-select: none;
		}

		/* Mỗi dòng co vừa chữ + canh giữa để vệt sáng ::after chạy đúng trên bề
		   rộng CHỮ (không phải bề rộng khối) — có thế vị trí từ khoá tính theo
		   tỉ lệ ký tự (--kf) mới khớp lúc vệt sáng đi qua.
		   Vệt sáng "mask trong chữ" (2026-09-19, theo yêu cầu) mà không cần
		   background-clip:text (không dùng được vì các span con tự có màu riêng
		   và lớp phủ từ khoá): dải sáng nằm TRÊN chữ với mix-blend-mode lighten
		   (theme sáng) / darken (theme tối) — kênh-max/min với nền thì trả về
		   đúng nền (vô hình), với nét chữ tối/sáng thì trả về màu vệt → chỉ hiện
		   bên trong glyph. Điều kiện để nền "vô hình": nền phải nằm TRONG nhóm
		   blend, nên dòng tự tô background: var(--bg) (giống hệt nền trang, không
		   thấy khác) + isolation: isolate; hộp dải sáng inset 0 và KHÔNG dịch
		   chuyển (xem .tc-line::after) để không lòi ra ngoài vùng có nền. */
		.tc-line {
			display: block;
			position: relative;
			isolation: isolate;
			width: fit-content;
			margin-inline: auto;
			background: var(--bg);
			--tc-sweep-delay: calc(var(--tc-end) + 300ms + var(--l) * var(--tc-sweep-dur));
		}

		/* Hộp dải sáng CỐ ĐỊNH đúng bằng hộp dòng (không translateX — phần hộp
		   thò ra ngoài dòng sẽ không có nền để blend và hiện nguyên màu, đã gặp
		   ở theme tối). Dải sáng di chuyển bằng background-position trên ảnh
		   gradient rộng 300%: vệt ở giữa ảnh, position 100% → 0% đưa tâm vệt từ
		   −0.5W tới +1.5W, tức đi qua bề rộng chữ trong nửa giữa hành trình
		   (25% → 75%) — giữ nguyên nhịp đã tính cho --kf. Vệt rộng 10% ảnh =
		   30% bề rộng dòng. */
		.tc-line::after {
			content: "";
			position: absolute;
			inset: 0;
			z-index: 1;
			background-image: linear-gradient(105deg, transparent 45%, var(--tc-shine) 50%, transparent 55%);
			background-size: 300% 100%;
			background-repeat: no-repeat;
			background-position-x: 100%;
			mix-blend-mode: var(--tc-blend);
			opacity: 0;
			pointer-events: none;
		}

		.tc-tree {
			font-size: 0.875rem;
			color: var(--ink-secondary);
		}

		.tc-me {
			margin-top: 0.2rem;
			font-size: 1rem;
			color: var(--ink-secondary);
		}

		.tc-w {
			display: inline-block;
		}

		/* Từ khoá: hai lớp chồng khít để chuyển thường → đậm bằng CROSSFADE thay
		   vì transition font-weight (2026-09-19, sau phản hồi "bold đậm luôn,
		   không chuyển dần"): font-weight chỉ nội suy được trên variable font và
		   với ease nhanh vẫn trông như nhảy; crossfade thì mượt trên MỌI font.
		   - Lớp nền = chính chữ trong span, ĐẬM, giữ layout ở bề rộng đậm ngay
		     từ đầu → lúc đậm lên không đẩy chữ bên cạnh (không giật dòng).
		   - Lớp phủ ::before = content: attr(data-w), weight thường, màu phụ,
		     canh giữa đè lên trên; ẩn dần khi lớp nền hiện màu.
		   Trạng thái CUỐI (không JS / giảm chuyển động): nền đậm+ink, phủ ẩn. */
		.tc-k {
			position: relative;
			font-weight: 600;
			color: var(--ink);
		}

		.tc-k::before {
			content: attr(data-w);
			position: absolute;
			inset: 0;
			text-align: center;
			white-space: nowrap;
			font-weight: 400;
			color: var(--ink-secondary);
			opacity: 0;
			pointer-events: none;
		}

		/* Hiệu ứng (nhịp 2026-09-19 lần 3 — thêm vệt sáng + dấu ngoặc):
		   1) dấu ngoặc mờ hiện trước (0.9s); từng từ mờ → nét 1.2s, cách nhau
		      180ms kể từ 400ms, TẤT CẢ ở weight thường → câu hiện xong ~4.7s.
		   2) sau --tc-end + 300ms, vệt sáng mờ chạy trái → phải qua dòng 1 rồi
		      dòng 2 (mỗi dòng --tc-sweep-dur = 2.4s, --l = chỉ số dòng); tâm vệt
		      đi qua bề rộng chữ trong nửa giữa hành trình (25% → 75%). Cụm từ
		      khoá crossfade thường → đậm 0.8s ease-in-out, canh giữa đúng lúc
		      tâm vệt đi tới vị trí của nó (--kf) → thứ tự tự nhiên theo chiều
		      đọc: Cây → phát triển → tôi → học hỏi → hoàn thiện, xong ~9.5s.
		   Khối <p> tự nó không fade (ghi đè [data-reveal] chung như hero làm).
		   Không JS (không .js-reveal) → trạng thái cuối, đọc đủ. */
		:global(.js-reveal) .tree-caption[data-reveal] {
			opacity: 1;
			transform: none;
			transition: none;
		}

		:global(.js-reveal) .tree-caption[data-reveal] .tc-quote {
			opacity: 0;
			transform: translateY(0.2em);
			transition:
				opacity 0.9s var(--ease-smooth) 100ms,
				transform 0.9s var(--ease-smooth) 100ms;
		}

		:global(.js-reveal) .tree-caption[data-reveal].is-visible .tc-quote {
			opacity: 0.55;
			transform: none;
		}

		:global(.js-reveal) .tree-caption[data-reveal].is-visible .tc-line::after {
			animation: tc-sweep var(--tc-sweep-dur) linear var(--tc-sweep-delay) both;
		}

		@keyframes tc-sweep {
			0% {
				opacity: 0;
				background-position-x: 100%;
			}
			15% {
				opacity: 1;
			}
			85% {
				opacity: 1;
			}
			100% {
				opacity: 0;
				background-position-x: 0%;
			}
		}

		:global(.js-reveal) .tree-caption[data-reveal] .tc-w {
			--tc-delay: calc(var(--tc-start) + var(--i) * var(--tc-step));
			opacity: 0;
			filter: blur(6px);
			transform: translateY(0.3em);
			transition:
				opacity var(--tc-in) var(--ease-smooth) var(--tc-delay),
				filter var(--tc-in) var(--ease-smooth) var(--tc-delay),
				transform var(--tc-in) var(--ease-smooth) var(--tc-delay);
		}

		:global(.js-reveal) .tree-caption[data-reveal].is-visible .tc-w {
			opacity: 1;
			filter: blur(0);
			transform: none;
		}

		/* Từ khoá lúc hiện ra: lớp phủ (thường, màu phụ) hiện, lớp nền (đậm)
		   trong suốt — nhìn y như mọi từ khác. Tới --tc-bold-delay: nền hiện màu
		   và phủ ẩn CÙNG một nhịp ease-in-out = crossfade thấy rõ quá trình. Mốc
		   = lúc tâm vệt sáng của dòng (kế thừa --tc-sweep-delay từ .tc-line) đi
		   tới --kf, trừ nửa thời lượng để crossfade ôm đúng khoảnh khắc đi qua.
		   Phải khai báo lại cả cụm transition vì shorthand ghi đè toàn bộ. */
		:global(.js-reveal) .tree-caption[data-reveal] .tc-k {
			--tc-bold-delay: calc(var(--tc-sweep-delay) + (0.25 + 0.5 * var(--kf)) * var(--tc-sweep-dur) - var(--tc-bold-in) / 2);
			color: transparent;
			transition:
				opacity var(--tc-in) var(--ease-smooth) var(--tc-delay),
				filter var(--tc-in) var(--ease-smooth) var(--tc-delay),
				transform var(--tc-in) var(--ease-smooth) var(--tc-delay),
				color var(--tc-bold-in) ease-in-out var(--tc-bold-delay);
		}

		:global(.js-reveal) .tree-caption[data-reveal] .tc-k::before {
			opacity: 1;
			transition: opacity var(--tc-bold-in) ease-in-out var(--tc-bold-delay);
		}

		:global(.js-reveal) .tree-caption[data-reveal].is-visible .tc-k {
			color: var(--ink);
		}

		:global(.js-reveal) .tree-caption[data-reveal].is-visible .tc-k::before {
			opacity: 0;
		}

		@media (prefers-reduced-motion: reduce) {
			:global(.js-reveal) .tree-caption[data-reveal] .tc-quote {
				opacity: 0.55;
				transform: none;
				transition: none;
			}
			:global(.js-reveal) .tree-caption[data-reveal].is-visible .tc-line::after {
				animation: none;
			}
			:global(.js-reveal) .tree-caption[data-reveal] .tc-w {
				opacity: 1;
				filter: none;
				transform: none;
				transition: none;
			}
			:global(.js-reveal) .tree-caption[data-reveal] .tc-k {
				color: var(--ink);
				transition: none;
			}
			:global(.js-reveal) .tree-caption[data-reveal] .tc-k::before {
				opacity: 0;
				transition: none;
			}
		}

		/* .era-kicker/.era-years/.era-year (chỉ số 01/04 + năm lớn đổi theo mốc
		   đang đọc) đã bỏ (2026-09-18, theo yêu cầu "không cần thể hiện mốc thời
		   gian") — panel giờ chỉ còn cây (.tree-figure) và câu chú thích
		   (.tree-caption) ở trên. `initTimeline()` bên dưới vẫn còn đoạn cập nhật
		   `#era-index`/`[data-era]` trong `.era-panel`, nhưng vô hại: các phần tử
		   đó không còn tồn tại nên querySelector trả về rỗng/null, code đã có
		   guard `if (indexEl)` từ trước — không cần sửa JS. */

		/* ---- Cách tôi làm việc: mảng tối tràn hai mép (thay dải công cụ, 2026-09-20) ----
		   Nền --band-bg (luôn tối ở cả hai theme), chữ --on-ink*, accent trên nền
		   tối = --band-accent (token mới, xem global.css). Logo DT nét + vệt sáng
		   (T8) giữ lại ở góc dưới-phải, nhỏ và mờ hơn: chỉ là kết cấu nền, không
		   tranh với nội dung. Tràn mép bằng margin âm theo 50vw; html/body đã
		   overflow-x: clip (clip KHÔNG tạo scroll container nên sticky vẫn chạy). */
		/* ⚠️ .process-scope — bao CẢ .process-band lẫn .tools-section (2026-09-21,
		   đồng bộ với trang chủ, xem ghi chú đầy đủ ở `.process-scope` trong
		   index.astro): containing block của position: sticky mặc định là ancestor
		   khối gần nhất — nếu chỉ để `<main>` bao thì dải chỉ nhả ghim khi cuộn qua
		   gần hết trang (rèm che vẫn phủ kín nên không lộ, nhưng ghim/compositing dư
		   một quãng dài không cần thiết). Bọc đúng [process-band + tools-section]
		   (không thêm height nhân tạo, auto = tổng hai khối cộng dồn bình thường)
		   để dải nhả ghim ĐÚNG lúc .tools-section (nối liền ngay sau, không khoảng
		   cách) cuộn lên chạm mép header — không sớm hơn (hở khoảng trắng, đã gặp
		   và sửa ở bản thử đầu tại trang chủ) không muộn hơn. */
		.process-scope {
			margin-top: clamp(1.5rem, 4vw, 2.5rem);
		}

		.process-band {
			/* Ghim dưới header (2026-09-21, yêu cầu): mép trên dải chạm đáy header thì
			   đứng lại, khối sau (.tools-section, trong cùng .process-scope) trượt lên
			   che dần. Nếu dải CAO HƠN phần viewport còn lại (tablet 2×2, mobile dọc)
			   thì ghim theo mép dưới thay vì mép trên: top âm = 100dvh − chiều cao dải
			   (− bottom nav trên mobile), để người đọc luôn cuộn hết bước 04 rồi dải
			   mới đứng lại và bị che — không có phần nào bị che trước khi đọc.
			   --band-h do script đo (ResizeObserver); không JS → mặc định 9999px →
			   top rất âm → dải không bao giờ ghim, cuộn như thường. */
			position: sticky;
			top: min(var(--header-h), calc(100vh - var(--bnav-h, 0px) - var(--band-h, 9999px)));
			top: min(var(--header-h), calc(100dvh - var(--bnav-h, 0px) - var(--band-h, 9999px)));
			z-index: 0;
			isolation: isolate;
			overflow: hidden;
			width: 100vw;
			margin-left: calc(50% - 50vw);
			/* Đáy ngắn hơn đỉnh (2026-09-20): box kết thúc ngay sau nội dung bước 04. */
			padding: clamp(3rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 3rem) clamp(2.5rem, 5vw, 3.5rem);
			background: var(--band-bg);
			color: var(--on-ink);
			/* Nhịp chuỗi: node 01 sáng ở --p0, mỗi đoạn nối vẽ trong --pseg; tổng
			   ≈ 0.5 + 3×0.9 + 0.45 (hàng công cụ) ≈ 4.2s. Đổi hai số này là cả
			   chuỗi đổi theo. */
			--p0: 0.5s;
			--pseg: 0.9s;
			--pgap: 2rem;
		}

		/* Mobile có bottom nav cố định (BaseLayout, 66px + safe-area) che mép dưới
		   viewport → trừ vào mốc ghim theo mép dưới để bước 04 không nằm dưới nav. */
		@media (max-width: 720px) {
			.process-band {
				--bnav-h: calc(66px + env(safe-area-inset-bottom, 0px));
			}
		}

		.process-inner {
			position: relative;
			max-width: calc(1160px - 2 * clamp(1.25rem, 5vw, 3rem));
			margin-inline: auto;
		}

		.band-logo {
			position: absolute;
			z-index: -1;
			/* Canh giữa theo chiều dọc box, sát mép phải gần nội dung bước 04 (yêu cầu
			   2026-09-20). Nét nền 0.07 + vệt sáng ×0.7 đủ mờ để chữ bước 04 vẫn đọc
			   được khi chồng lên. */
			right: -5%;
			top: 50%;
			transform: translateY(-50%);
			height: 92%;
			max-height: 560px;
			width: auto;
			pointer-events: none;
		}

		/* Nét nền gần như ẩn; viền chỉ hiện nơi vệt sáng đi qua. Hạ thêm so với dải
		   cũ (0.1 → 0.07, vệt sáng ×0.7) vì giờ là nền cho chữ, không phải điểm
		   nhấn chính. */
		.band-logo .base {
			fill: none;
			stroke: url(#dt-edge);
			stroke-width: 1;
			opacity: 0.07;
		}

		/* Vệt sáng gradient hai đầu: các lớp dash cùng tâm do glintLayers sinh ra —
		   mỗi lớp nhận --w/--o/--blur/--c/--s0 inline. Chạy một vòng 8s, linear;
		   chỉ animate stroke-dashoffset. */
		.band-logo .g {
			fill: none;
			stroke: var(--c);
			stroke-width: var(--w);
			opacity: calc(var(--o) * 0.7);
			filter: blur(var(--blur));
			stroke-linecap: butt;
			animation: dt-glint 8s linear infinite;
		}

		@keyframes dt-glint {
			from {
				stroke-dashoffset: var(--s0);
			}
			to {
				stroke-dashoffset: calc(var(--s0) - 1000px);
			}
		}

		/* Intro: nhãn nhỏ + tiêu đề + lede, cột hẹp bên trên; hiện trước chuỗi
		   (reveal chung 0.7s, lệch 0/80/160ms). */
		.process-intro {
			max-width: 62ch;
			/* 2.5–3.5rem → 1.5–2rem (2026-09-20): intro sát timeline hơn. */
			margin-bottom: clamp(1.5rem, 3vw, 2rem);
		}

		.process-intro .section-label {
			color: var(--on-ink-secondary);
		}

		.process-intro h2 {
			font-size: clamp(1.7rem, 3.2vw, 2.4rem);
			line-height: 1.15;
			margin: 0 0 1rem;
			color: var(--on-ink);
		}

		/* Hai vế xếp hai dòng cố định; vế "đến gần sản phẩm" màu accent trên nền
		   tối (--band-accent, đủ tương phản ở cả hai theme). */
		.process-title-line {
			display: block;
		}

		.process-title-accent {
			color: var(--band-accent);
		}

		.process-lede {
			margin: 0;
			font-size: 1.05rem;
			line-height: 1.65;
			color: var(--on-ink-secondary);
		}

		:global(.js-reveal) .process-intro h2[data-reveal] {
			transition-delay: 80ms;
		}

		:global(.js-reveal) .process-lede[data-reveal] {
			transition-delay: 160ms;
		}

		/* ---- 4 bước trên MỘT đường nối ----
		   Desktop: 4 cột, node ở mép trên-trái mỗi bước, đường nằm ngang qua tâm
		   node. Mỗi bước tự mang ĐOẠN nối tới bước kế (.pstep-seg: từ tâm node của
		   mình, dài calc(100% + gap) = đúng tới tâm node bước sau vì node cùng toạ
		   độ trong ô) — nên đường vẫn liên tục khi đổi lưới 2×2 hay dọc, chỉ cần
		   đổi HƯỚNG đoạn theo breakpoint. Bước cuối không có đoạn. */
		.process-steps {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: var(--pgap);
		}

		.pstep {
			position: relative;
			padding-top: 2.25rem;
		}

		.pstep-node {
			position: absolute;
			top: 0;
			left: 0;
			z-index: 2;
			box-sizing: border-box;
			width: 14px;
			height: 14px;
			border-radius: 50%;
			background: var(--band-bg);
			border: 2px solid var(--on-ink-secondary);
		}

		/* Hộp đoạn nối dày 14px canh tâm với node, overflow hidden; đường 2px ở
		   giữa; ĐẦU SÁNG là nền radial ở cuối hộp .pstep-seg-head — hộp trượt từ
		   -100% về 0 nên chấm chạy đúng theo mép đang vẽ (trượt, không scale →
		   chấm không méo). */
		.pstep-seg {
			position: absolute;
			top: 0;
			left: 7px;
			z-index: 1;
			width: calc(100% + var(--pgap));
			height: 14px;
			overflow: hidden;
			pointer-events: none;
		}

		.pstep:last-child .pstep-seg {
			display: none;
		}

		.pstep-seg-line {
			position: absolute;
			top: 6px;
			left: 0;
			right: 0;
			height: 2px;
			background: color-mix(in srgb, var(--band-accent) 55%, transparent);
			transform-origin: left center;
		}

		.pstep-seg-head {
			position: absolute;
			inset: 0;
			background: radial-gradient(circle at right center, var(--band-accent) 0 3px, transparent 4px);
			filter: drop-shadow(0 0 4px var(--band-accent)) drop-shadow(0 0 10px color-mix(in srgb, var(--band-accent) 60%, transparent));
			opacity: 0;
		}

		.pstep-body {
			position: relative;
		}

		/* Số thứ tự to nhưng tương phản thấp (16%), cùng họ số bước ở trang chủ. */
		.pstep-num {
			display: block;
			font-family: var(--display);
			font-size: 2rem; /* 2.4 → 2rem (−17%, 2026-09-20) */
			line-height: 1;
			color: var(--on-ink);
			opacity: 0.16;
			margin-bottom: 0.9rem;
		}

		.pstep-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 40px;
			height: 40px;
			border-radius: var(--radius-md);
			background: var(--ink-surface);
			color: var(--band-accent);
			margin-bottom: 0.9rem;
		}

		.pstep h3 {
			font-size: 1.15rem;
			line-height: 1.3;
			margin: 0 0 0.5rem;
			color: var(--on-ink);
		}

		.pstep p {
			margin: 0;
			font-size: 0.92rem;
			line-height: 1.6;
			color: var(--on-ink-secondary);
		}

		/* ---- Chuỗi xuất hiện (chỉ khi html.js-reveal; mở khoá bởi .is-visible của
		   <ol>) — mốc theo --i: node i sáng ở p0 + i·pseg; đoạn i vẽ từ đúng lúc đó
		   trong pseg (linear, đầu sáng bám mép, tắt khi chạm node kế); nội dung i
		   hiện ở mốc node của nó trừ 0.15s (ngay trước khi đường chạm). Mỗi bước
		   nối tiếp bước trước không khoảng dừng. Chạy MỘT lần (fill both). Trạng
		   thái "đã qua": đường mờ 55%, node sáng vừa có quầng nhẹ. <ol> tự nó không
		   fade (ghi đè [data-reveal] chung). Không JS → khối dưới không áp. ---- */
		:global(.js-reveal) .process-steps[data-reveal] {
			opacity: 1;
			transform: none;
			transition: none;
		}

		:global(.js-reveal) .process-steps[data-reveal] .pstep-node {
			transform: scale(0.7);
			transition:
				border-color 0.35s var(--ease-smooth),
				background-color 0.35s var(--ease-smooth),
				box-shadow 0.35s var(--ease-smooth),
				transform 0.35s var(--ease-smooth);
			transition-delay: calc(var(--p0) + var(--i) * var(--pseg));
		}

		:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep-node,
		:global(html:not(.js-reveal)) .pstep-node {
			transform: none;
			background: var(--band-accent);
			border-color: var(--band-accent);
			box-shadow: 0 0 0 4px color-mix(in srgb, var(--band-accent) 22%, transparent);
		}

		:global(.js-reveal) .process-steps[data-reveal] .pstep-seg-line {
			transform: scaleX(0);
		}

		:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep-seg-line {
			animation: pseg-draw var(--pseg) linear both;
			animation-delay: calc(var(--p0) + var(--i) * var(--pseg));
		}

		:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep-seg-head {
			animation: pseg-head-x var(--pseg) linear both;
			animation-delay: calc(var(--p0) + var(--i) * var(--pseg));
		}

		@keyframes pseg-draw {
			from {
				transform: scaleX(0);
			}
			to {
				transform: scaleX(1);
			}
		}

		@keyframes pseg-head-x {
			0% {
				opacity: 1;
				transform: translateX(-100%);
			}
			88% {
				opacity: 1;
			}
			100% {
				opacity: 0;
				transform: translateX(0);
			}
		}

		/* Nội dung bước vào theo TỪNG LỚP (2026-09-21): số → icon → tiêu đề → mô tả,
		   lệch nhau 80–100ms, thời lượng tăng dần 0.5 → 0.75s, tất cả bắt đầu từ mốc
		   của bước (--pb = mốc node trừ 0.15s). .pstep-body tự nó không fade. */
		:global(.js-reveal) .process-steps[data-reveal] .pstep {
			--pb: max(0s, calc(var(--p0) + var(--i) * var(--pseg) - 0.15s));
		}

		:global(.js-reveal) .process-steps[data-reveal] .pstep-body > * {
			opacity: 0;
			transform: translateY(10px);
			transition:
				opacity var(--ld, 0.6s) var(--ease-smooth) calc(var(--pb) + var(--lt, 0ms)),
				transform var(--ld, 0.6s) var(--ease-smooth) calc(var(--pb) + var(--lt, 0ms));
		}

		:global(.js-reveal) .process-steps[data-reveal] .pstep-num {
			--lt: 0ms;
			--ld: 0.5s;
		}

		:global(.js-reveal) .process-steps[data-reveal] .pstep-icon {
			--lt: 80ms;
			--ld: 0.55s;
		}

		:global(.js-reveal) .process-steps[data-reveal] .pstep-body h3 {
			--lt: 170ms;
			--ld: 0.62s;
		}

		:global(.js-reveal) .process-steps[data-reveal] .pstep-body p {
			--lt: 270ms;
			--ld: 0.75s;
		}

		:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep-body > * {
			opacity: 1;
			transform: none;
		}

		/* Số thứ tự đích là 16%, không phải 1. */
		:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep-num {
			opacity: 0.16;
		}

		/* Giảm chuyển động: đường, node, nội dung, công cụ hiện đủ ngay; không vẽ,
		   không vệt sáng logo. */
		@media (prefers-reduced-motion: reduce) {
			:global(.js-reveal) .process-steps[data-reveal] .pstep-node,
			:global(.js-reveal) .process-steps[data-reveal] .pstep-body > *,
			:global(.js-reveal) .process-steps[data-reveal] .pstep-seg-line,
			:global(.js-reveal) .process-steps[data-reveal] .pstep-seg-head {
				transition: none !important;
				animation: none !important;
				transition-delay: 0s !important;
			}
			:global(.js-reveal) .process-steps[data-reveal] .pstep-node {
				transform: none;
				background: var(--band-accent);
				border-color: var(--band-accent);
				box-shadow: 0 0 0 4px color-mix(in srgb, var(--band-accent) 22%, transparent);
			}
			:global(.js-reveal) .process-steps[data-reveal] .pstep-seg-line {
				transform: none !important;
			}
			:global(.js-reveal) .process-steps[data-reveal] .pstep-body > * {
				opacity: 1;
				transform: none;
			}
			:global(.js-reveal) .process-steps[data-reveal] .pstep-num {
				opacity: 0.16;
			}
			.band-logo .g {
				animation: none;
			}
		}

		/* Tablet ≤ 900px: lưới 2×2, DOM vẫn 01→04 nhưng 03 đặt DƯỚI 02 và 04 dưới 01
		   để đường ziczac 01 → 02 ↓ 03 ← 04 liên tục: đoạn của 02 quay dọc xuống
		   (dài = cao ô + gap; hai ô cùng hàng cao bằng nhau nên chạm đúng node 03),
		   đoạn của 03 chạy NGƯỢC sang trái (gốc bên phải, đầu sáng ở mép trái). */
		@media (max-width: 900px) {
			.process-steps {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
			.pstep:nth-child(3) {
				grid-column: 2;
				grid-row: 2;
			}
			.pstep:nth-child(4) {
				grid-column: 1;
				grid-row: 2;
			}

			.pstep:nth-child(2) .pstep-seg {
				top: 7px;
				left: 0;
				width: 14px;
				height: calc(100% + var(--pgap));
			}
			.pstep:nth-child(2) .pstep-seg-line {
				top: 0;
				bottom: 0;
				left: 6px;
				right: auto;
				width: 2px;
				height: auto;
				transform-origin: center top;
			}
			.pstep:nth-child(2) .pstep-seg-head {
				background: radial-gradient(circle at center bottom, var(--band-accent) 0 3px, transparent 4px);
			}
			:global(.js-reveal) .process-steps[data-reveal] .pstep:nth-child(2) .pstep-seg-line {
				transform: scaleY(0);
			}
			:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep:nth-child(2) .pstep-seg-line {
				animation-name: pseg-draw-y;
			}
			:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep:nth-child(2) .pstep-seg-head {
				animation-name: pseg-head-y;
			}

			.pstep:nth-child(3) .pstep-seg {
				left: auto;
				right: calc(100% - 7px);
			}
			.pstep:nth-child(3) .pstep-seg-line {
				transform-origin: right center;
			}
			.pstep:nth-child(3) .pstep-seg-head {
				background: radial-gradient(circle at left center, var(--band-accent) 0 3px, transparent 4px);
			}
			:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep:nth-child(3) .pstep-seg-head {
				animation-name: pseg-head-x-rev;
			}

			.band-logo {
				right: -18%;
				height: 46%;
				max-height: 380px;
			}
		}

		@keyframes pseg-draw-y {
			from {
				transform: scaleY(0);
			}
			to {
				transform: scaleY(1);
			}
		}

		@keyframes pseg-head-y {
			0% {
				opacity: 1;
				transform: translateY(-100%);
			}
			88% {
				opacity: 1;
			}
			100% {
				opacity: 0;
				transform: translateY(0);
			}
		}

		@keyframes pseg-head-x-rev {
			0% {
				opacity: 1;
				transform: translateX(100%);
			}
			88% {
				opacity: 1;
			}
			100% {
				opacity: 0;
				transform: translateX(0);
			}
		}

		/* Mobile ≤ 600px: timeline dọc, đường bên trái qua tâm node, nội dung lùi
		   phải; mọi đoạn quay dọc (dài = cao ô + gap → chạm đúng node ô sau dù các
		   ô cao khác nhau). Selector dùng :nth-child(n) để đủ specificity ghi đè
		   các rule nth-child(2)/(3) của tablet (cùng match ở bề rộng này). */
		@media (max-width: 600px) {
			.process-steps {
				grid-template-columns: 1fr;
				--pgap: 1.75rem;
			}
			.pstep:nth-child(3),
			.pstep:nth-child(4) {
				grid-column: auto;
				grid-row: auto;
			}
			.pstep {
				padding-top: 0;
				padding-left: 2.25rem;
			}
			.pstep-node {
				top: 0.3rem;
			}
			.pstep:nth-child(n) .pstep-seg {
				top: calc(0.3rem + 7px);
				left: 0;
				right: auto;
				width: 14px;
				height: calc(100% + var(--pgap));
			}
			.pstep:nth-child(n) .pstep-seg-line {
				top: 0;
				bottom: 0;
				left: 6px;
				right: auto;
				width: 2px;
				height: auto;
				transform-origin: center top;
			}
			.pstep:nth-child(n) .pstep-seg-head {
				background: radial-gradient(circle at center bottom, var(--band-accent) 0 3px, transparent 4px);
			}
			:global(.js-reveal) .process-steps[data-reveal] .pstep:nth-child(n) .pstep-seg-line {
				transform: scaleY(0);
			}
			:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep:nth-child(n) .pstep-seg-line {
				animation-name: pseg-draw-y;
			}
			:global(.js-reveal) .process-steps[data-reveal].is-visible .pstep:nth-child(n) .pstep-seg-head {
				animation-name: pseg-head-y;
			}
			.pstep-num {
				font-size: 1.6rem;
				margin-bottom: 0.6rem;
			}
			/* Logo nhỏ ở góc, chữ không đè lên (nội dung lùi trái, logo thò phải). */
			.band-logo {
				right: -30%;
				height: 30%;
				max-height: 260px;
				opacity: 0.6;
			}
		}

		/* ---- Công cụ hỗ trợ: section riêng (2026-09-20, tách khỏi mảng tối) ----
		   Nền --bg-soft tràn hai mép = tông trung gian giữa --band-bg và --bg của
		   Chuyên môn (light: #f6f7f6 giữa #121815 và #fff; dark: #161c19 giữa #090c0b
		   và #0f1412). Card --surface + shadow-md (quy tắc Cards), 4 cột cùng cao
		   (grid stretch) → 2×2 ≤900px → 1 cột ≤600px. Mặc định trung tính: tile
		   bg-soft + icon ink-secondary; hover: card nâng 3px, tile accent-tint, icon
		   nét sang accent, mark Figma/Photoshop tô màu hãng (Icon.astro,
		   .brand-hover-host). Vào lần lượt trái→phải qua data-reveal (240ms + i×110);
		   icon .icon-anim pop từng bộ phận cùng lúc card lộ ra (Icon.astro). */
		.tools-section {
			width: 100vw;
			margin-left: calc(50% - 50vw);
			padding: clamp(2rem, 5vw, 3rem) clamp(1.25rem, 5vw, 3rem);
			/* Đổi nền với Chuyên môn (2026-09-20, yêu cầu): công cụ trên nền trang
			   --bg, Chuyên môn mang nền --bg-soft tràn mép (xem .block-after-band). */
			background: var(--bg);
		}

		.tools-inner {
			max-width: calc(1160px - 2 * clamp(1.25rem, 5vw, 3rem));
			margin-inline: auto;
		}

		.tools-grid {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.tool-card {
			display: flex;
			flex-direction: column;
			padding: 1.6rem 1.4rem 1.5rem;
			border-radius: var(--radius-lg);
			background: var(--surface);
			box-shadow: var(--shadow-md);
			transition:
				transform 0.3s var(--ease-smooth),
				box-shadow 0.3s var(--ease-smooth);
		}

		.tool-card:hover {
			transform: translateY(-3px);
			box-shadow: var(--shadow-lg);
		}

		.tool-card .tool-icon {
			margin-bottom: 1.1rem;
			background: var(--bg-soft);
			color: var(--ink-secondary);
			transition:
				color 0.3s var(--ease-smooth),
				background-color 0.3s var(--ease-smooth);
		}

		.tool-card:hover .tool-icon {
			background: var(--accent-tint);
			color: var(--accent);
		}

		.tool-card h3 {
			font-size: 1.15rem;
			line-height: 1.3;
			margin: 0 0 0.5rem;
		}

		.tool-card p {
			margin: 0;
			font-size: 0.92rem;
			line-height: 1.6;
			color: var(--ink-secondary);
		}

		:global(.js-reveal) .tool-card[data-reveal] {
			transition-delay: calc(var(--i) * 110ms);
		}

		@media (max-width: 900px) {
			.tools-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 600px) {
			.tools-grid {
				grid-template-columns: 1fr;
			}
		}

		/* ---- Chuyên môn: 3 thẻ riêng, lưới 3 cột ----
		   Thẻ trắng + shadow trên nền trắng (quy tắc Cards). Icon trong tile 64px
		   có chuyển động (Icon.astro). */
		.expertise-grid {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.expertise-card {
			padding: 1.75rem 1.5rem 1.6rem;
			border-radius: var(--radius-lg);
			background: var(--surface);
			box-shadow: var(--shadow-md);
			transition: box-shadow 0.3s var(--ease-smooth), transform 0.3s var(--ease-smooth);
		}

		.expertise-card:hover {
			box-shadow: var(--shadow-lg);
			transform: translateY(-3px);
		}

		:global(.js-reveal) .expertise-card[data-reveal],
		:global(.js-reveal) .platform-card[data-reveal] {
			transition-delay: calc(var(--i) * 90ms);
		}

		/* Icon tile: 48px chuẩn, biến thể -lg 64px. Bo md, nền accent-tint, icon
		   accent-strong — xem DESIGN.md › Iconography. */
		.icon-tile {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			width: 48px;
			height: 48px;
			border-radius: var(--radius-md);
			background: var(--accent-tint);
			color: var(--accent-strong);
		}

		.icon-tile-lg {
			width: 64px;
			height: 64px;
		}

		.expertise-card .icon-tile {
			margin-bottom: 1.1rem;
		}

		.expertise-card h3,
		.platform-card h3 {
			font-size: 1.3rem;
			line-height: 1.25;
			margin-bottom: 0.55rem;
		}

		.expertise-card p,
		.platform-card p {
			margin: 0;
			color: var(--ink-secondary);
			font-size: 0.95rem;
		}

		/* ---- Nền tảng: 2 hộp ngang nền soft, tách khỏi 3 thẻ chuyên môn ---- */
		.platform-grid {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.platform-card {
			display: flex;
			gap: 1.25rem;
			align-items: flex-start;
			padding: 1.5rem;
			border-radius: var(--radius-lg);
			background: var(--bg-soft);
			transition: background 0.3s var(--ease-smooth), transform 0.3s var(--ease-smooth), box-shadow 0.3s var(--ease-smooth);
		}

		.platform-card:hover {
			background: var(--surface);
			box-shadow: var(--shadow-md);
			transform: translateY(-3px);
		}

		@media (max-width: 900px) {
			.expertise-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 640px) {
			.expertise-grid,
			.platform-grid {
				grid-template-columns: 1fr;
			}
		}

		@media (max-width: 900px) {
			.timeline-layout {
				grid-template-columns: 1fr;
			}
			/* Panel là trang trí; ở màn hẹp nhường chỗ cho nội dung. */
			.era-panel {
				display: none;
			}
		}

	</style>
</BaseLayout>
